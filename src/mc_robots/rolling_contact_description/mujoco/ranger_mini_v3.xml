<mujoco model="ranger_mini_v3">
  <compiler angle="radian" inertiafromgeom="false"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" cone="pyramidal" jacobian="dense"/>
  <size memory="64M"/>
  <default>
    <joint damping="0.05" armature="0.001"/>
    <geom condim="4" friction="0.8 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
  </default>
  <asset>
    <material name="white" rgba="0.82 0.84 0.86 1"/>
    <material name="black" rgba="0.035 0.04 0.045 1"/>
    <material name="silver" rgba="0.55 0.58 0.62 1"/>
    <material name="orange" rgba="0.95 0.30 0.05 1"/>
  </asset>
  <worldbody>
    <!-- The free-joint frame is at the chassis shell centre. Wheel axle
         bodies are 35 mm below it, preserving the original ground contacts. -->
    <body name="chassis" pos="0 0 0.16">
      <freejoint name="root"/>
      <!-- Keep the free-joint, chassis shell, and inertial frame coincident. -->
      <inertial pos="0 0 0" mass="65" diaginertia="1.03 2.03 2.91"/>

      <!-- Explicit marker for the frame convention; it is visual-only and has no contact. -->
      <site name="chassis_frame" type="sphere" pos="0 0 0" size="0.008" rgba="0.95 0.15 0.05 1"/>

      <!-- Visible Ranger Mini V3 body. Contact geometry is kept separate so the model remains easy to audit. -->
      <geom name="chassis_lower_visual" type="box" pos="0 0 -0.075" size="0.27 0.19 0.04"
            material="black" contype="0" conaffinity="0"/>
      <geom name="chassis_shell_visual" type="box" pos="0 0 0" size="0.30 0.22 0.07"
            material="white" contype="0" conaffinity="0"/>
      <geom name="chassis_deck_visual" type="box" pos="0 0 0.09" size="0.28 0.20 0.0175"
            material="black" contype="0" conaffinity="0"/>
      <geom name="front_accent_visual" type="box" pos="0.305 0 0" size="0.0125 0.18 0.045"
            material="orange" contype="0" conaffinity="0"/>
      <geom name="front_bumper_visual" type="capsule" fromto="0.34 -0.18 -0.015 0.34 0.18 -0.015" size="0.018"
            material="black" contype="0" conaffinity="0"/>
      <geom name="rear_bumper_visual" type="capsule" fromto="-0.34 -0.18 -0.015 -0.34 0.18 -0.015" size="0.018"
            material="black" contype="0" conaffinity="0"/>
      <geom name="left_deck_rail" type="capsule" fromto="-0.23 0.17 0.13 0.23 0.17 0.13" size="0.012"
            material="silver" contype="0" conaffinity="0"/>
      <geom name="right_deck_rail" type="capsule" fromto="-0.23 -0.17 0.13 0.23 -0.17 0.13" size="0.012"
            material="silver" contype="0" conaffinity="0"/>
      <geom name="chassis_collision" type="box" pos="0 0 0" size="0.30 0.22 0.07" rgba="0 0 0 0"/>

      <body name="front_left_knuckle" pos="0.247 0.182 -0.035">
        <joint name="front_left_steer" type="hinge" axis="0 0 1" damping="0.001" limited="true"
               range="-1.5707963267948966 1.5707963267948966"/>
        <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
        <geom name="front_left_knuckle_visual" type="cylinder" size="0.035 0.05" material="silver"
              contype="0" conaffinity="0"/>
        <body name="front_left_wheel">
          <joint name="front_left_drive" type="hinge" axis="0 1 0" damping="0.05" limited="false"/>
          <inertial pos="0 0 0" mass="2" diaginertia="0.0089 0.015625 0.0089"/>
          <geom name="front_left_wheel_collision" type="cylinder" size="0.125 0.04"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="black"/>
          <geom name="front_left_hub_visual" type="cylinder" size="0.073 0.041"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="silver" contype="0" conaffinity="0"/>
        </body>
      </body>

      <body name="front_right_knuckle" pos="0.247 -0.182 -0.035">
        <joint name="front_right_steer" type="hinge" axis="0 0 1" damping="0.001" limited="true"
               range="-1.5707963267948966 1.5707963267948966"/>
        <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
        <geom name="front_right_knuckle_visual" type="cylinder" size="0.035 0.05" material="silver"
              contype="0" conaffinity="0"/>
        <body name="front_right_wheel">
          <joint name="front_right_drive" type="hinge" axis="0 1 0" damping="0.05" limited="false"/>
          <inertial pos="0 0 0" mass="2" diaginertia="0.0089 0.015625 0.0089"/>
          <geom name="front_right_wheel_collision" type="cylinder" size="0.125 0.04"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="black"/>
          <geom name="front_right_hub_visual" type="cylinder" size="0.073 0.041"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="silver" contype="0" conaffinity="0"/>
        </body>
      </body>

      <body name="rear_left_knuckle" pos="-0.247 0.182 -0.035">
        <joint name="rear_left_steer" type="hinge" axis="0 0 1" damping="0.001" limited="true"
               range="-1.5707963267948966 1.5707963267948966"/>
        <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
        <geom name="rear_left_knuckle_visual" type="cylinder" size="0.035 0.05" material="silver"
              contype="0" conaffinity="0"/>
        <body name="rear_left_wheel">
          <joint name="rear_left_drive" type="hinge" axis="0 1 0" damping="0.05" limited="false"/>
          <inertial pos="0 0 0" mass="2" diaginertia="0.0089 0.015625 0.0089"/>
          <geom name="rear_left_wheel_collision" type="cylinder" size="0.125 0.04"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="black"/>
          <geom name="rear_left_hub_visual" type="cylinder" size="0.073 0.041"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="silver" contype="0" conaffinity="0"/>
        </body>
      </body>

      <body name="rear_right_knuckle" pos="-0.247 -0.182 -0.035">
        <joint name="rear_right_steer" type="hinge" axis="0 0 1" damping="0.001" limited="true"
               range="-1.5707963267948966 1.5707963267948966"/>
        <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
        <geom name="rear_right_knuckle_visual" type="cylinder" size="0.035 0.05" material="silver"
              contype="0" conaffinity="0"/>
        <body name="rear_right_wheel">
          <joint name="rear_right_drive" type="hinge" axis="0 1 0" damping="0.05" limited="false"/>
          <inertial pos="0 0 0" mass="2" diaginertia="0.0089 0.015625 0.0089"/>
          <geom name="rear_right_wheel_collision" type="cylinder" size="0.125 0.04"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="black"/>
          <geom name="rear_right_hub_visual" type="cylinder" size="0.073 0.041"
                quat="0.7071067811865476 0.7071067811865476 0 0" material="silver" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- The wheels sit partly inside the body envelope. Their suspension/axle
         assembly permits this geometry, so chassis-wheel self-contact must be
         excluded while wheel-terrain contact remains active. -->
    <exclude body1="chassis" body2="front_left_wheel"/>
    <exclude body1="chassis" body2="front_right_wheel"/>
    <exclude body1="chassis" body2="rear_left_wheel"/>
    <exclude body1="chassis" body2="rear_right_wheel"/>
  </contact>
  <actuator>
    <motor name="front_left_steer_motor" joint="front_left_steer" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
    <motor name="front_left_drive_motor" joint="front_left_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
    <motor name="front_right_steer_motor" joint="front_right_steer" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
    <motor name="front_right_drive_motor" joint="front_right_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
    <motor name="rear_left_steer_motor" joint="rear_left_steer" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
    <motor name="rear_left_drive_motor" joint="rear_left_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
    <motor name="rear_right_steer_motor" joint="rear_right_steer" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
    <motor name="rear_right_drive_motor" joint="rear_right_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
  </actuator>
</mujoco>
