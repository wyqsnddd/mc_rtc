<mujoco model="rolling_diff">
  <compiler angle="radian" inertiafromgeom="false"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" cone="pyramidal" jacobian="dense"/>
  <size memory="32M"/>
  <default>
    <joint damping="0.05" armature="0.001"/>
    <geom condim="4" friction="0.8 0.01 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
  </default>
  <worldbody>
    <body name="chassis" pos="0 0 0.2">
      <freejoint name="root"/>
      <inertial pos="0 0 -0.08" mass="10" diaginertia="0.32 0.50 0.62"/>
      <geom name="chassis_visual" type="box" size="0.35 0.25 0.08" contype="0" conaffinity="0"
            rgba="0.2 0.35 0.75 1"/>
      <geom name="chassis_collision" type="box" size="0.32 0.22 0.07" rgba="0.2 0.35 0.75 0"/>
      <body name="left_wheel" pos="0 0.3 0">
        <joint name="left_drive" type="hinge" axis="0 1 0" limited="false"/>
        <inertial pos="0 0 0" mass="1" diaginertia="0.021 0.040 0.021"/>
        <geom name="left_wheel_collision" type="cylinder" size="0.2 0.04"
              quat="0.7071067811865476 0.7071067811865476 0 0" rgba="0.12 0.12 0.12 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.3 0">
        <joint name="right_drive" type="hinge" axis="0 1 0" limited="false"/>
        <inertial pos="0 0 0" mass="1" diaginertia="0.021 0.040 0.021"/>
        <geom name="right_wheel_collision" type="cylinder" size="0.2 0.04"
              quat="0.7071067811865476 0.7071067811865476 0 0" rgba="0.12 0.12 0.12 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_motor" joint="left_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
    <motor name="right_motor" joint="right_drive" gear="1" ctrllimited="true" ctrlrange="-35 35"/>
  </actuator>
</mujoco>
