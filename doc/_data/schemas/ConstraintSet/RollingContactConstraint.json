{
  "title": "mc_solver::RollingContactConstraint",
  "type": "object",
  "properties":
  {
    "type": { "const": "rollingContact" },
    "robot": { "$ref": "../common/ConstraintSet_robot.json" },
    "terrainNormal": { "$ref": "../Eigen/Vector3d.json", "default": [0, 0, 1] },
    "longitudinal": { "type": "string", "enum": ["hard", "soft"], "default": "hard" },
    "velocityGain": { "type": "number", "minimum": 0, "default": 20 },
    "rollingWeight": { "type": "number", "exclusiveMinimum": 0, "default": 1000 },
    "constrainNormal": { "type": "boolean", "default": true },
    "differentialPlanar": { "type": "boolean", "default": false },
    "softLateralRows":
    {
      "type": "boolean",
      "description": "Move the lateral rows into the objective, one slack per wheel, so an over-determined multi-steering chassis stays feasible",
      "default": false
    },
    "lateralSlackWeight":
    {
      "type": "number",
      "description": "Single common objective weight on every lateral slack, in acceleration-task units",
      "exclusiveMinimum": 0,
      "default": 100000
    },
    "trackRotatingRates": { "type": "boolean", "default": false },
    "rollingRateWeight": { "type": "number", "minimum": 0, "default": 200 },
    "steeringRateWeight": { "type": "number", "minimum": 0, "default": 200 },
    "wheels":
    {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../common/RollingContactWheel.json" }
    }
  },
  "required": ["type", "wheels"]
}
